<?xml version="1.0"?>

<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:set="http://www.sitecore.net/xmlconfig/set">
  <sitecore>
    <log4net>
      <root>
        <priority patch:attribute="value" set:value="DEBUG" />
      </root>
      <logger name="Sitecore.Diagnostics.Publishing" additivity="false">
        <level patch:attribute="value" set:value="DEBUG" />
      </logger>
    </log4net>

    <pipelines>
      <edgePublishItem patch:source="ExperienceEdgeConnector.config">
        <processor patch:instead="*[@type='Sitecore.ExperienceEdge.Connector.Client.Pipelines.EdgePublishItem.UpdateStatistics,  Sitecore.ExperienceEdge.Connector.Client']"
          type="Sitecore.ExperienceEdge.Connector.Client.Pipelines.EdgePublishItem.UpdateStatistics, Sitecore.ExperienceEdge.Connector.Client"
          method="Process" resolve="true">
          <traceToLog>true</traceToLog>
        </processor>
      </edgePublishItem>
    </pipelines>
  </sitecore>
</configuration>