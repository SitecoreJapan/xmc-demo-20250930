{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["dom", "esnext"],

    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
